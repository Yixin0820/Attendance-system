# 复制为 .env 后按需修改；不建这个文件也能跑（以下均为代码内默认值）

APP_NAME=晚自习考勤管理系统 API
DEBUG=true

# -------- 数据库 --------
# 本地开发（零安装，默认）
DATABASE_URL=sqlite:///./attendance.db
# 生产：先 docker compose up -d db，再改成下面这行并安装 psycopg
# DATABASE_URL=postgresql+psycopg://attendance:attendance@127.0.0.1:5432/attendance

# -------- 安全 --------
# 必须改！用于签发 JWT。生成方式：python -c "import secrets;print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me
ACCESS_TOKEN_EXPIRE_MINUTES=720

# -------- CORS（前端来源白名单，逗号分隔） --------
# 4180 = npm start 的预览端口；5173 = npm run dev
# 注意：不要填 null，那等于允许本机任意 HTML 文件调用本接口
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:4180

# -------- 文件上传 --------
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=10
