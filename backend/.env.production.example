# 生产环境配置模板：cp .env.production.example .env 后逐项填写
# 这个文件与 docker-compose.prod.yml 配合使用

DEBUG=false

# -------- 数据库 --------
DATABASE_URL=postgresql+psycopg://attendance:请把密码改成强口令@db:5432/attendance
POSTGRES_USER=attendance
POSTGRES_PASSWORD=请把密码改成强口令
POSTGRES_DB=attendance

# -------- 安全 --------
# 必须改！生成：python -c "import secrets;print(secrets.token_urlsafe(48))"
# 不改会直接拒绝启动（多 worker 时随机密钥会导致「登录成功但立刻 401」）
SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=720

# -------- CORS --------
# 填真实域名；不要写 *，也不要写 null
CORS_ORIGINS=https://你的域名

# -------- 文件与进程 --------
UPLOAD_DIR=/app/uploads
MAX_UPLOAD_MB=10
UVICORN_WORKERS=2
